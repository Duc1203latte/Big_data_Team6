n\"/>\n</li>\n<li itemprop=\"itemListElement\" itemscope=\"\" itemtype=\"http://schema.org/ListItem\">\n<a href=\"/dien-thoai-di-dong\" itemprop=\"item\"><span content=\"Điện thoại\" itemprop=\"name\">Điện thoại</span></a>\n<meta content=\"2\" itemprop=\"position\"/>\n</li>\n<li itemprop=\"itemListElement\" itemscope=\"\" itemtype=\"http://schema.org/ListItem\">\n<a href=\"/dien-thoai-di-dong/iphone\" itemprop=\"item\"><span content=\"Apple\" itemprop=\"name\">Apple</span></a>\n<meta content=\"3\" itemprop=\"position\"/>\n</li>\n<li itemprop=\"itemListElement\" itemscope=\"\" itemtype=\"http://schema.org/ListItem\">\n<a href=\"/dien-thoai-di-dong/iphone-18-series\" itemprop=\"item\"><span content=\"iPhone 18 Series &amp; iPhone Duo\" itemprop=\"name\">iPhone 18 Series &amp; iPhone Duo</span></a>\n<meta content=\"4\" itemprop=\"position\"/>\n</li>\n<li itemprop=\"itemListElement\" itemscope=\"\" itemtype=\"http://schema.org/ListItem\">\n<a class=\"actived\" href=\"/dien-thoai/iphone-18-pro-max\" itemprop=\"item\" title=\"iPhone 18 Pro Max Giá Từ 41.49Tr, Thu Cũ Tới 5Tr\"><span content=\"iPhone 18 Pro Max 256GB\" itemprop=\"name\">iPhone 18 Pro Max 256GB</span></a>\n<meta content=\"5\" itemprop=\"position\"/>\n</li>\n</ol><ul class=\"specs-content\">\n<li>\n<strong>Độ phân giải camera</strong>\n<span>Hệ thống camera 48MP Pro Fusion<br/>Camera 18MP Center Stage<br/>Khẩu độ ƒ/1,9</span>\n</li>\n<li>\n<strong>Quay phim</strong>\n<span>Quay video 4K Dolby Vision ở tốc độ 24 fps, 25 fps, 30 fps, 60 fps, 100 fps (Fusion Main), hoặc 120 fps (Fusion Main)</span>\n</li>\n<li>\n<strong>Vi xử lý</strong>\n<span>Chip A20 Pro</span>\n</li>\n<li>\n<strong>Hệ điều hành</strong>\n<span>iOS 27</span>\n</li>\n<li>\n<strong>Vi xử lý đồ họa (GPU)</strong>\n<span>GPU 7 lõi với Neural Accelerators<br/>Bộ Đôi Neural Engine 16 lõi<br/>Công nghệ dò tia tốc độ cao bằng phần cứng</span>\n</li>\n<li>\n<strong>Bộ nhớ trong</strong>\n<span>256 GB</span>\n</li>\n<li>\n<strong>Thẻ nhớ ngoài</strong>\n<span>Không hỗ trợ</span>\n</li>\n<li>\n<strong>Kết Nối NFC</strong>\n<span>Có</span>\n</li>\n<li>\n<strong>Mạng di động</strong>\n<span>5G</span>\n</li>\n<li>\n<strong>Số khe SIM</strong>\n<span>SIM kép (nano SIM và eSIM)<br/>Hỗ trợ eSIM kép</span>\n</li>\n<li>\n<strong>Wi-Fi</strong>\n<span>Wi-Fi 802.11 a/b/g/n/ac/6e/7</span>\n</li>\n<li>\n<strong>Công nghệ màn hình</strong>\n<span>Super Retina XDR</span>\n</li>\n<li>\n<strong>Kích thước màn hình</strong>\n<span>6.9\"</span>\n</li>\n<li>\n<strong>Độ phân giải</strong>\n<span>1320 x 2868</span>\n</li>\n<li>\n<strong>Độ sáng màn hình</strong>\n<span>3000nits</span>\n</li>\n<li>\n<strong>Cổng kết nối/sạc</strong>\n<span>Type-C</span>\n</li>\n<li>\n<strong>Jack tai nghe</strong>\n<span>Không</span>\n</li>\n<li>\n<strong>Bluetooth</strong>\n<span>6.0, A2DP, LE</span>\n</li>\n<li>\n<strong>Định vị</strong>\n<span>GPS (L1+L5), GLONASS, GALILEO, BDS, QZSS, NavIC</span>\n</li>\n<li>\n<strong>Kích thước</strong>\n<span>163,4 mm x71,9 mm x8,75 mm</span>\n</li>\n<li>\n<strong>Trọng lượng</strong>\n<span>249 gram</span>\n</li>\n<li>\n<strong>Dung lượng pin sản phẩm</strong>\n<span>Sử dụng thông thường<br/>Lên đến 29 giờ<br/>Thời gian xem video<br/>Lên đến 43 giờ<br/>Thời gian xem video (trực tuyến)<br/>Lên đến 38 giờ</span>\n</li>\n<li>\n<strong>Loại pin</strong>\n<span>lithium-ion</span>\n</li>\n<li>\n<strong>Kháng nước, kháng bụi</strong>\n<span>Đạt mức IP68 (chống nước ở độ sâu tối đa 6 mét trong vòng tối đa 30 phút) theo tiêu chuẩn IEC 60529</span>\n</li>\n<li>\n<strong>Bảo mật sinh trắc học\t</strong>\n<span>Face ID</span>\n</li>\n<li>\n<strong>Sản phẩm bao gồm</strong>\n<span>iPhone với iOS 27<br/>Cáp Sạc USB‑C (1 m)<br/>Tài liệu</span>\n</li>\n</ul></body></html>",
