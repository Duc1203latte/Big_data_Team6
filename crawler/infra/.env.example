# Chép thành infra/.env (file .env không commit) rồi sửa nếu cần:
#   cp infra/.env.example infra/.env
# docker compose tự đọc infra/.env khi chạy trong thư mục infra/.

# --- Kafka (đợt 1) ---
KAFKA_IMAGE=apache/kafka:3.9.1
# Id cluster KRaft, cố định cho một volume dữ liệu. Đổi id trên volume cũ thì broker không khởi động.
# Tạo id mới: docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=7j2jEhfNScuRvGHOhosEvw
KAFKA_HEAP=512m
KAFKA_MEM_LIMIT=1g

# --- HDFS (đợt 2) ---
HADOOP_IMAGE=apache/hadoop:3.4.3
# Id cluster HDFS, cố định cho volume NameNode. Đổi id trên volume cũ thì DataNode không đăng ký được.
HDFS_CLUSTER_ID=CID-bigdata-team6
NAMENODE_HEAP=512m
NAMENODE_MEM_LIMIT=768m
DATANODE_HEAP=384m
DATANODE_MEM_LIMIT=512m

# --- Spark (đợt 3) ---
# Spark 3.5.x / Scala 2.12 / Java 17. Package Kafka và Delta khai báo trong spark/conf/spark-defaults.conf,
# phải cùng version Spark (spark-sql-kafka-0-10_2.12:3.5.8) và Delta hỗ trợ Spark 3.5 (delta-spark 3.3.x).
SPARK_IMAGE=apache/spark:3.5.8-scala2.12-java17-python3-ubuntu
SPARK_MASTER_MEM_LIMIT=512m
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=1536m
SPARK_WORKER_MEM_LIMIT=3g
