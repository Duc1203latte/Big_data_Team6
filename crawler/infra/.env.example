# Chép thành infra/.env (file .env không commit) rồi sửa nếu cần:
#   cp infra/.env.example infra/.env
# docker compose tự đọc infra/.env khi chạy trong thư mục infra/.

# --- Kafka (đợt 1) ---
KAFKA_IMAGE=apache/kafka:3.9.1
# Id cluster KRaft, cố định cho một volume dữ liệu. Đổi id trên volume cũ thì broker không khởi động.
# Tạo id mới: docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=7j2jEhfNScuRvGHOhosEvw
KAFKA_HEAP=512m
KAFKA_MEM_LIMIT=1g
